# TriNova Client Portal — Environment Configuration
APP_NAME="TriNova Accounting"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.up.railway.app/
APP_SECRET=trinova_production_secret_key_minimum_32_characters_long!
PRACTICE_KEY=trinova-default

# Database Configuration
# On Railway, you can simply add a MySQL service and reference:
# MYSQL_URL=${{MySQL.MYSQL_URL}}
# Or specify individual variables:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trinova_portal
DB_USER=root
DB_PASS=

# Resend Email Delivery (Optional)
# Get a free API key at https://resend.com and configure your sender domain.
RESEND_API_KEY=
RESEND_FROM="TriNova Accounting <onboarding@resend.dev>"

# Sloane / Headless REST API Integration Key
TRINOVA_API_KEY=tn_sec_live_sloane_readwrite_2026


