# TriNova Client Portal - Production Environment Configuration
APP_ENV=production
# Set APP_URL to your live Railway domain (e.g., https://your-app.up.railway.app) or verified custom domain
APP_URL=https://testnova-production-7b65.up.railway.app
APP_SECRET=ChangeThisToA64CharacterRandomHexKeyInProduction
PRACTICE_KEY=trinova-default

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trinova_portal
DB_USER=trinova_db_user
DB_PASS=SecureProductionPassword123!

# Storage Configuration (outside public web root)
STORAGE_DIR=/var/www/trinova_storage

# Mailer Configuration (SMTP / Resend API)
# For instant email delivery via Resend (Signature invites, completion certificates, OTPs):
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="TriNova Accounting <onboarding@resend.dev>"
# Or traditional SMTP fallback:
MAIL_DRIVER=smtp
MAIL_HOST=mail.trinova.co.uk
MAIL_PORT=587
MAIL_USERNAME=noreply@trinova.co.uk
MAIL_PASSWORD=ProductionMailSecretPassword
MAIL_FROM_ADDRESS=noreply@trinova.co.uk
MAIL_FROM_NAME="TriNova Accounting Portal"

# Sloane / Headless REST API Integration Key
TRINOVA_API_KEY=tn_sec_live_sloane_readwrite_2026

